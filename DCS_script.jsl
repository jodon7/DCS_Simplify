




// Ensure variables defined here don't leak globally
Names Default To Here( 1 );

// --- Start/Cancel dialog (modal) ---
choice = .;
New Window( "Sort by RUN_START_TIME",
    <<Modal,
    V List Box(
        Spacer Box( size( 0, 6 ) ),
        Text Box(
            "Ready to sort the current data table by RUN_START_TIME (descending)?",
            <<Set Font Size( 12 )
        ),
        Spacer Box( size( 0, 10 ) ),
        H Center Box(
            H List Box(
                Button Box( "Start",
                    choice = 1;
                    // Close the modal window
                    Throw();
                ),
                Button Box( "Cancel",
                    choice = 0;
                    // Close the modal window
                    Throw();
                )
            )
        )
    )
);

// If user cancelled, stop the script with a friendly message
If( !Is Missing( choice ) & choice == 0,
    Show( "Operation cancelled by user." );
    Stop(); // or just return();
);

dt = Current Data Table();

// Sort the data table by RUN_START_TIME in descending order
dt << Sort(
    By( :RUN_START_TIME ),
    Order( Descending ),
    Replace Table
);

// Create or update the column "DCS Type"
dt << New Column( "DCS Type",
    Character,
    Formula(
        If(
            :ROUTE == "ECTW.356",
            If(
                Lag(:ROUTE, -1) == "ECTW.304",
                "Post TW DCS for " ||
                If( Contains( Lag(:RECIPE, -1), "P5/P-P5" ),
                    Substitute(
                        Lag(:RECIPE, -1),
                        "SCCM-POLY/P5/P-P5-", "",
